<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>tech.xfa</groupId>
  <artifactId>login-hint-idp</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>XFA Keycloak login_hint mapper</name>
  <description>
    A Keycloak authenticator that forwards the authenticated user's email as the
    OpenID Connect login_hint when redirecting to an external Identity Provider.
    Published by XFA (https://xfa.tech) to add XFA device verification as a
    post-login step in Keycloak.
  </description>
  <url>https://github.com/gl-ventures/xfa-keycloak-login-hint-mapper</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>XFA</name>
    <url>https://xfa.tech</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/gl-ventures/xfa-keycloak-login-hint-mapper</url>
    <connection>scm:git:https://github.com/gl-ventures/xfa-keycloak-login-hint-mapper.git</connection>
    <developerConnection>scm:git:git@github.com:gl-ventures/xfa-keycloak-login-hint-mapper.git</developerConnection>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <keycloak.version>26.6.3</keycloak.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-services</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
